            }
          ]
        },
        {
          "ruleId": "R21",
          "level": "error",
          "message": {
            "text": "BREAKING: request field `email` changed from string to integer (Consumers parse this value as the old type; a different type breaks deserialization, validation, and downstream logic.)"
          },
          "locations": [
